{
  "_说明": "桌宠的表情差分表。key 对应 sprites/final/expr_<key>.png；name 是右键菜单里的名字；match 里的词用来按表情包文件名反查（比如发『生气_鼓腮.png』就匹配到 angry）；say 是触发时冒泡说的话。",
  "expressions": [
    { "key": "angry", "name": "生气", "match": ["生气", "鼓腮"], "secs": 4.5, "say": ["哼。", "不跟你说话了。"] },
    { "key": "speechless", "name": "无语", "match": ["无语", "冷汗", "不是很懂"], "secs": 4.0, "say": ["……", "随你。"] },
    { "key": "sad", "name": "难过", "match": ["吃瘪", "流泪", "难过", "委屈"], "secs": 5.0, "say": ["有点委屈。", "……嗯。"] },
    { "key": "sleepy", "name": "困了", "match": ["困", "哈欠", "晚安", "盖被"], "secs": 5.0, "say": ["困……", "让我眯一会儿。"] },
    { "key": "happy", "name": "开心", "match": ["开心", "加油", "放假", "撒花", "歪嘴笑"], "secs": 4.0, "say": ["嗯。", "今天还不错。"] },
    { "key": "smug", "name": "得意", "match": ["挑衅", "回礼", "得意", "牛"], "secs": 4.0, "say": ["怎么样。", "我记下了。"] }
  ]
}
